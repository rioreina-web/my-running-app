+// MARK: - The read: back half vs front half
+
+@Suite("TrendsRead half-vs-half")
+struct TrendsReadHalvesTests {
+
+    private func bucket(miles: Double, recovery: Int, days: Int) -> TrendsBucket {
+        TrendsBucket(
+            startISO: "2026-08-03", date: Date(timeIntervalSince1970: 0), label: "Aug 3",
+            miles: miles, keyCount: 0, longCount: 0, channel: .easy, qualityLoad: 0,
+            mood: nil, niggles: [], recovery: recovery, isWeekStart: true, dayCount: days
+        )
+    }
+
+    /// The window almost never ends on a Sunday, so at week grain the last
+    /// bucket is a partial week. A mean over buckets counted that stub as a
+    /// full week and pulled the back-half average down.
+    @Test("a 3-day stub week does not depress a per-day rate")
+    func partialWeekCountsOnlyTheDaysItHolds() {
+        // Two full weeks at 7 mi/day, then a 3-day stub at the same rate.
+        let halves = [
+            bucket(miles: 49, recovery: 60, days: 7),
+            bucket(miles: 49, recovery: 60, days: 7),
+            bucket(miles: 21, recovery: 60, days: 3),
+        ]
+        // The old bucket mean read (49 + 49 + 21) / 3 = 39.7 "per week".
+        #expect(TrendsRead.perDay(halves) { $0.miles } == 7.0)
+    }
+
+    /// Recovery arrives already averaged per week, so it needs weighting by
+    /// days rather than re-averaging — otherwise a 1-day stub speaks as loudly
+    /// as the 7-day week beside it.
+    @Test("recovery is weighted by days, not by buckets")
+    func recoveryIsDayWeighted() {
+        let halves = [
+            bucket(miles: 0, recovery: 60, days: 7),
+            bucket(miles: 0, recovery: 20, days: 1),
+        ]
+        // Unweighted this was (60 + 20) / 2 = 40 — a single day dragging the
+        // average down 20 points.
+        #expect(TrendsRead.dayWeightedMean(halves) { Double($0.recovery) } == 55.0)
+    }
+
+    /// At day grain every `dayCount` is 1, so the 30-day and 3-month windows
+    /// must be arithmetically unchanged by this.
+    @Test("day grain is unchanged")
+    func dayGrainMatchesAPlainMean() {
+        let ds = [bucket(miles: 4, recovery: 50, days: 1),
+                  bucket(miles: 8, recovery: 70, days: 1)]
+        #expect(TrendsRead.perDay(ds) { $0.miles } == 6.0)
+        #expect(TrendsRead.dayWeightedMean(ds) { Double($0.recovery) } == 60.0)
+    }
