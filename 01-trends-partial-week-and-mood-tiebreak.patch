+    /// Summed total ÷ summed days. For bucket fields that hold a TOTAL —
+    /// `miles`, which a week bucket sums across its days.
+    ///
+    /// Internal rather than private so `TrendsSignalTests` can pin the
+    /// arithmetic directly; the partial-week bug it fixes is invisible in the
+    /// headline string until the delta happens to cross a threshold.
+    static func perDay(
+        _ buckets: [TrendsBucket],
+        _ total: (TrendsBucket) -> Double
+    ) -> Double {
+        let days = buckets.reduce(0) { $0 + $1.dayCount }
+        guard days > 0 else { return 0 }
+        return buckets.reduce(0) { $0 + total($1) } / Double(days)
+    }
+
+    /// Mean weighted by days. For bucket fields that are already an AVERAGE —
+    /// `recovery`, which a week bucket stores as the mean of its own days.
+    /// Averaging those again unweighted would give a 3-day week the same say
+    /// as a 7-day one.
+    static func dayWeightedMean(
+        _ buckets: [TrendsBucket],
+        _ value: (TrendsBucket) -> Double
+    ) -> Double {
+        let days = buckets.reduce(0) { $0 + $1.dayCount }
+        guard days > 0 else { return 0 }
+        return buckets.reduce(0) { $0 + value($1) * Double($1.dayCount) } / Double(days)
     }
 
