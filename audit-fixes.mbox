From f2dea23891e7ec0ae38ad7395118dc9cb41ec104 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 04:07:16 +0000
Subject: [PATCH 18/21] Fix 3.3 + 3.5: distinguish failures from emptiness in
 Content Library and onboarding
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- ContentLibraryService swallows its throw and returns [], and the view
  branched on videos.isEmpty straight to "No Videos Yet - check back soon".
  An athlete on a bad connection concluded the category was genuinely empty
  and stopped opening it. There was no retry and no pull-to-refresh, and
  their only exit was the close button. Now disambiguated via the service's
  errorMessage, with an error state and a Try Again CTA.

- OnboardingView dropped the goal the athlete typed whenever
  AuthManager.userId was still empty — which is the common case, since this
  is the last onboarding step immediately after signup. `try?` also ate RLS
  rejections and offline failures. They landed in the app with no goal, no
  error, and pace zones on defaults. Now waits for the session the same way
  VoiceLogViewModel.loadHistory does, and surfaces a failure instead of
  hiding it. target_date also formats in local time, matching the GoalsView
  fix.
---
 .../RunningLog/App/OnboardingView.swift       | 66 +++++++++++++++----
 .../ContentLibrary/ContentLibraryView.swift   | 30 ++++++++-
 2 files changed, 81 insertions(+), 15 deletions(-)

diff --git a/RunningLog/RunningLog/App/OnboardingView.swift b/RunningLog/RunningLog/App/OnboardingView.swift
index 5a23ab2..c69cf7d 100644
--- a/RunningLog/RunningLog/App/OnboardingView.swift
+++ b/RunningLog/RunningLog/App/OnboardingView.swift
@@ -513,20 +513,58 @@ struct OnboardingView: View {
         guard totalSeconds > 0 else { return }
 
         Task {
-            let userId = AuthManager.shared.userId
-            guard !userId.isEmpty else { return }
-
-            _ = try? await supabase
-                .from("user_goals")
-                .insert([
-                    "user_id": userId,
-                    "goal_title": "\(selectedDistance.replacingOccurrences(of: "_", with: " ").capitalized) Goal",
-                    "goal_type": selectedDistance,
-                    "target_time": "\(goalHours):\(String(format: "%02d", goalMinutes)):\(String(format: "%02d", goalSeconds))",
-                    "target_date": ISO8601DateFormatter().string(from: Date().addingTimeInterval(86400 * 120)),
-                    "status": "active",
-                ])
-                .execute()
+            // A brand-new user finishes signup and types this on the LAST
+            // onboarding step, so auth has often not resolved yet. The old
+            // `guard !userId.isEmpty else { return }` dropped the goal on the
+            // floor in exactly that window — and `try?` swallowed RLS
+            // rejections and offline failures too. The athlete landed in the
+            // app with no goal, no error, and pace zones on defaults, with no
+            // idea the value they typed had been discarded.
+            //
+            // Wait for the session the same way VoiceLogViewModel.loadHistory
+            // does (up to ~3s), then report a failure rather than hide it.
+            var userId = AuthManager.shared.userId
+            var authWaits = 0
+            while userId.isEmpty && authWaits < 10 {
+                try? await Task.sleep(for: .milliseconds(300))
+                userId = AuthManager.shared.userId
+                authWaits += 1
+            }
+            guard !userId.isEmpty else {
+                await MainActor.run {
+                    ErrorReporter.shared.report(
+                        .processing("We couldn't save your goal just now. You can set it any time from Goals.")
+                    )
+                }
+                return
+            }
+
+            // target_date is formatted in the athlete's own timezone — see the
+            // UTC off-by-one fixed in GoalsView.
+            let iso = ISO8601DateFormatter()
+            iso.formatOptions = [.withFullDate]
+            iso.timeZone = .current
+
+            do {
+                _ = try await supabase
+                    .from("user_goals")
+                    .insert([
+                        "user_id": userId,
+                        "goal_title": "\(selectedDistance.replacingOccurrences(of: "_", with: " ").capitalized) Goal",
+                        "goal_type": selectedDistance,
+                        "target_time": "\(goalHours):\(String(format: "%02d", goalMinutes)):\(String(format: "%02d", goalSeconds))",
+                        "target_date": iso.string(from: Date().addingTimeInterval(86400 * 120)),
+                        "status": "active",
+                    ])
+                    .execute()
+            } catch {
+                await MainActor.run {
+                    ErrorReporter.shared.report(
+                        error,
+                        context: "save your goal"
+                    )
+                }
+            }
         }
     }
 }
