From f85d68d5358b6139af57c5bb639382134fa366ec Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:59:06 +0000
Subject: [PATCH 12/21] Fix 2.6: stop dedup silently discarding rest-day
 check-ins
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

dedupedByPhysicalWorkout() skipped any row with no distance before
clustering, so it never entered a cluster and never came back out. The
whole helper exists to stop miles being counted twice, and a row with no
miles cannot double-count anything — dropping them was pure loss.

A rest-day memo ("legs are trashed", no distance) was fetched and then
discarded before any consumer saw it. The Train tab's voice-memo count
undercounted — five memos in a week could read as two — and mood(on:)
could never surface a non-running day, even though the code calling it
documents exactly that fallback.

Mileless rows now pass straight through. Every consumer aggregates miles,
so they contribute zero and no total changes.
---
 RunningLog/RunningLog/App/LogDedup.swift | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/RunningLog/RunningLog/App/LogDedup.swift b/RunningLog/RunningLog/App/LogDedup.swift
index cd3eea9..ef7060e 100644
--- a/RunningLog/RunningLog/App/LogDedup.swift
+++ b/RunningLog/RunningLog/App/LogDedup.swift
@@ -11,6 +11,10 @@
 //
 //  Rule:
 //    1. Group rows by calendar day.
+//    1b. Rows with no distance pass straight through. The rule below is
+//       about not counting miles twice; a row with no miles can't. This
+//       is what keeps rest-day check-ins and other qualitative entries
+//       alive for the consumers that count memos and read mood.
 //    2. If any GPS-source row (strava | auto_sync) exists on the day,
 //       drop voice_log rows from the day. They mirror the GPS row with
 //       user-stated distance and would double-count.
@@ -43,10 +47,23 @@ extension Array where Element == TodayLogRow {
         var result: [TodayLogRow] = []
 
         for (_, dayLogs) in byDay {
-            let hasGps = dayLogs.contains { LogDedupHelpers.isGpsSource($0.source) }
+            // Rows carrying no distance are passed straight through. This whole
+            // helper exists to stop miles being counted twice, and a row with no
+            // miles cannot double-count anything. They used to be dropped
+            // silently — a rest-day check-in ("legs are trashed", no distance)
+            // was fetched and then discarded before any consumer saw it, so the
+            // voice-memo count undercounted and mood(on:) could never surface a
+            // non-running day, despite the code that calls it documenting
+            // exactly that fallback.
+            let (mileless, withMiles) = dayLogs.reduce(into: ([TodayLogRow](), [TodayLogRow]())) { acc, log in
+                if (log.miles ?? 0) > 0 { acc.1.append(log) } else { acc.0.append(log) }
+            }
+            result.append(contentsOf: mileless)
+
+            let hasGps = withMiles.contains { LogDedupHelpers.isGpsSource($0.source) }
             let candidates = hasGps
-                ? dayLogs.filter { LogDedupHelpers.isGpsSource($0.source) }
-                : dayLogs
+                ? withMiles.filter { LogDedupHelpers.isGpsSource($0.source) }
+                : withMiles
 
             // Cluster by distance — longer workouts first so the cluster
             // anchor is the largest run on that day. Tight 0.1 mi
