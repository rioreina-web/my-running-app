From a1b1cf493421c8075c242792b64a1c3f71acb161 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:53:19 +0000
Subject: [PATCH 07/21] Fix 1.8: tear down the voice recorder and release the
 audio session

VoiceLogView had no onDisappear, no interruption handling, and only
deactivated the audio session on the start-failure path.

Two consequences. A phone call or a dismissal mid-memo suspended the
recorder while the display timer kept counting, so the athlete saved a
truncated file stamped with the full duration and was never told. And
because the .playAndRecord session was never deactivated, their music
never resumed and later video played out of the earpiece.

stopRecording now releases the recorder and deactivates the session with
.notifyOthersOnDeactivation; onDisappear stops an in-flight recording; and
an interruption observer stops cleanly and says so in plain language
rather than counting over dead air.
---
 .../RunningLog/Workouts/VoiceLogView.swift    | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/RunningLog/RunningLog/Workouts/VoiceLogView.swift b/RunningLog/RunningLog/Workouts/VoiceLogView.swift
index 1eab436..8d8fee9 100644
--- a/RunningLog/RunningLog/Workouts/VoiceLogView.swift
+++ b/RunningLog/RunningLog/Workouts/VoiceLogView.swift
@@ -175,6 +175,28 @@ struct VoiceLogView: View {
                 await viewModel.loadHistory()
             }
         }
+        .onDisappear {
+            // Never leave a recorder running behind a dismissed view. Without
+            // this the timer kept counting while the recorder was suspended,
+            // and the athlete saved a truncated file stamped with the full
+            // duration — silently, with no way to tell.
+            if isRecording { stopRecording() }
+            deactivateAudioSession()
+        }
+        .onReceive(NotificationCenter.default.publisher(for: AVAudioSession.interruptionNotification)) { note in
+            // A phone call, a timer, Siri. iOS suspends the recorder; if we
+            // don't notice, the UI keeps counting over dead air.
+            guard let info = note.userInfo,
+                  let raw = info[AVAudioSessionInterruptionTypeKey] as? UInt,
+                  let type = AVAudioSession.InterruptionType(rawValue: raw),
+                  type == .began
+            else { return }
+
+            if isRecording {
+                stopRecording()
+                viewModel.statusMessage = "Recording stopped — something else needed the microphone. What you captured so far is saved."
+            }
+        }
         .animation(.spring(response: 0.4), value: viewModel.statusMessage)
         .sheet(isPresented: $showWorkoutPicker) {
             WorkoutPickerSheet(
@@ -893,12 +915,29 @@ struct VoiceLogView: View {
         }
     }
 
+    /// Hand the audio route back to whatever had it before we started.
+    ///
+    /// The session is activated in `.playAndRecord` to record and was never
+    /// deactivated, so the athlete's music stayed paused after every memo and
+    /// later video playback came out of the earpiece instead of the speaker.
+    private func deactivateAudioSession() {
+        do {
+            try AVAudioSession.sharedInstance().setActive(false, options: .notifyOthersOnDeactivation)
+        } catch {
+            // Non-fatal: another part of the app may legitimately still hold
+            // the session. Nothing the athlete can act on, so log only.
+            print("[VoiceLog] Failed to deactivate audio session: \(error)")
+        }
+    }
+
     private func stopRecording() {
         audioRecorder?.stop()
+        audioRecorder = nil
         timer?.invalidate()
         timer = nil
         isRecording = false
         pendingRecordingDuration = recordingDuration
+        deactivateAudioSession()
 
         guard recordingURL != nil else {
             viewModel.statusMessage = "Error: No recording found"
