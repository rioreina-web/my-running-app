From 9d935a1a96c8121b2d5be632cd0e7f210a34c77e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:49:37 +0000
Subject: [PATCH 04/21] Fix 1.4: stamp user_id on restored rows so backups
 actually restore
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

TrainingLog, UserGoal and ScheduledWorkout have no userId property, so
their encoded upsert payload omitted user_id entirely. On a new device the
backup's row ids don't exist yet, the upsert takes the INSERT path, and
the row goes in with user_id NULL — rejected by RLS. Every run and every
voice memo, which is the entire point of the backup, failed to restore
behind a vague "some tables failed to restore".

Added a UserScoped<T> encoding wrapper that writes the current account's
id into the same keyed container after the model encodes itself. Applied
to all six tables: for the three models that already carry user_id this
re-homes the rows to the restoring account, which is the correct restore
semantics (the old account's id is not writable by this user anyway).

Restore now fails fast with a clear message when no session is present,
rather than uploading rows that RLS will silently reject.

NOTE: worth an end-to-end test on a second account before beta — a backup
people trust and that doesn't restore is worse than no backup.
---
 .../RunningLog/Shared/RestoreService.swift    | 77 +++++++++++++++++--
 1 file changed, 69 insertions(+), 8 deletions(-)

diff --git a/RunningLog/RunningLog/Shared/RestoreService.swift b/RunningLog/RunningLog/Shared/RestoreService.swift
index ac50fdb..2a599c3 100644
--- a/RunningLog/RunningLog/Shared/RestoreService.swift
+++ b/RunningLog/RunningLog/Shared/RestoreService.swift
@@ -63,14 +63,31 @@ final class RestoreService {
         var summary = RestoreSummary()
         var failedTables: [String] = []
 
+        // Every restored row is stamped with the account doing the restoring.
+        //
+        // TrainingLog, UserGoal and ScheduledWorkout carry no userId property at
+        // all, so their encoded payload omitted user_id entirely. On a fresh
+        // install the backup's ids don't exist yet, the upsert takes the INSERT
+        // path, and the row goes in with user_id NULL — rejected by RLS. Every
+        // run and every voice memo, which is the whole point of the backup,
+        // failed to restore behind a vague "some tables failed".
+        //
+        // Stamping the current user is also the correct semantics for the three
+        // models that DO carry user_id: restoring into a new account should
+        // re-home the rows to it, not preserve the old account's id (which this
+        // user could not write to anyway).
+        guard let userId = AuthManager.shared.currentUserId, !userId.isEmpty else {
+            throw RestoreError.notSignedIn
+        }
+
         // Restore each table independently — failures don't block remaining tables
         let tables: [(String, String, () async throws -> Int)] = [
-            ("Restoring training logs...", "training_logs", { try await self.upsertBatch("training_logs", items: backup.trainingLogs) }),
-            ("Restoring training plans...", "training_plans", { try await self.upsertBatch("training_plans", items: backup.trainingPlans) }),
-            ("Restoring scheduled workouts...", "scheduled_workouts", { try await self.upsertBatch("scheduled_workouts", items: backup.scheduledWorkouts) }),
-            ("Restoring goals...", "user_goals", { try await self.upsertBatch("user_goals", items: backup.userGoals) }),
-            ("Restoring injuries...", "injuries", { try await self.upsertBatch("injuries", items: backup.injuries) }),
-            ("Restoring fitness snapshots...", "fitness_snapshots", { try await self.upsertBatch("fitness_snapshots", items: backup.fitnessSnapshots) }),
+            ("Restoring training logs...", "training_logs", { try await self.upsertBatch("training_logs", items: backup.trainingLogs, userId: userId) }),
+            ("Restoring training plans...", "training_plans", { try await self.upsertBatch("training_plans", items: backup.trainingPlans, userId: userId) }),
+            ("Restoring scheduled workouts...", "scheduled_workouts", { try await self.upsertBatch("scheduled_workouts", items: backup.scheduledWorkouts, userId: userId) }),
+            ("Restoring goals...", "user_goals", { try await self.upsertBatch("user_goals", items: backup.userGoals, userId: userId) }),
+            ("Restoring injuries...", "injuries", { try await self.upsertBatch("injuries", items: backup.injuries, userId: userId) }),
+            ("Restoring fitness snapshots...", "fitness_snapshots", { try await self.upsertBatch("fitness_snapshots", items: backup.fitnessSnapshots, userId: userId) }),
         ]
 
         for (index, (label, tableName, restore)) in tables.enumerated() {
@@ -104,14 +121,14 @@ final class RestoreService {
         return summary
     }
 
-    private func upsertBatch<T: Encodable>(_ table: String, items: [T]) async throws -> Int {
+    private func upsertBatch<T: Encodable>(_ table: String, items: [T], userId: String) async throws -> Int {
         guard !items.isEmpty else { return 0 }
 
         // Upsert in chunks of 100 to avoid payload limits
         let chunkSize = 100
         for start in stride(from: 0, to: items.count, by: chunkSize) {
             let end = min(start + chunkSize, items.count)
-            let chunk = Array(items[start..<end])
+            let chunk = items[start..<end].map { UserScoped(base: $0, userId: userId) }
             try await supabase
                 .from(table)
                 .upsert(chunk, onConflict: "id")
@@ -121,6 +138,50 @@ final class RestoreService {
     }
 }
 
+// MARK: - UserScoped
+
+/// Encodes `base` exactly as it would encode itself, then writes `user_id` into
+/// the same keyed container.
+///
+/// Restore needs every row to carry the account doing the restoring, but half
+/// the backup models have no `userId` property to set. Rather than add a field
+/// to six domain models — which would also change what BackupService exports and
+/// what every read path decodes — this wraps them at the point of upload.
+///
+/// Writing `user_id` after `base.encode(to:)` means it wins for the models that
+/// do already encode one, which is the behaviour restore wants.
+private struct UserScoped<T: Encodable>: Encodable {
+    let base: T
+    let userId: String
+
+    private struct AnyKey: CodingKey {
+        let stringValue: String
+        var intValue: Int? { nil }
+        init(_ stringValue: String) { self.stringValue = stringValue }
+        init?(stringValue: String) { self.stringValue = stringValue }
+        init?(intValue: Int) { nil }
+    }
+
+    func encode(to encoder: Encoder) throws {
+        try base.encode(to: encoder)
+        var container = encoder.container(keyedBy: AnyKey.self)
+        try container.encode(userId, forKey: AnyKey("user_id"))
+    }
+}
+
+// MARK: - RestoreError
+
+enum RestoreError: LocalizedError {
+    case notSignedIn
+
+    var errorDescription: String? {
+        switch self {
+        case .notSignedIn:
+            return "You need to be signed in to restore a backup. Sign in and try again."
+        }
+    }
+}
+
 // MARK: - RestoreSummary
 
 struct RestoreSummary {
-- 
