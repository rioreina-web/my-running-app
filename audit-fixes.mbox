From bb400bc69b11bac5bb49a64bf4303092f2f745b4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:57:26 +0000
Subject: [PATCH 10/21] Fix 2.3 + 2.11: pace unit mismatch and mileage
 averaging in WorkoutHistoryAnalyzer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three defects in the same file.

1. PaceProgression was populated in minutes per mile while every field is
   documented and consumed as seconds per mile. The proof is in the file:
   line 144 multiplies by 60 for the fitness index, then the values are
   stored raw. An 8:00/mi runner reported averageEasyPace = 8.0; the
   no-data fallback returns 540 for the same field. Both go to the AI
   assessment under the same key, so the model saw "8 seconds per mile".

2. recent4WeekAverage divided by the number of weeks that had runs, not
   the number of weeks in the window — a week with no running is a missing
   dictionary key, not a zero. 40 miles then three blank weeks reported 40
   mpw instead of 10, and that value floors calculateRecommendedMileage,
   so an athlete returning from a layoff was started at 4x their base.

3. The mileage trend compared windows that both included the current,
   partial week, so early in any week an athlete reading flat reported
   .down and picked up a "declining mileage trend" risk factor. Both
   windows are now anchored to the start of the current week and exclude
   it.
---
 .../Analysis/WorkoutHistoryAnalyzer.swift     | 42 ++++++++++++++-----
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/RunningLog/RunningLog/Analysis/WorkoutHistoryAnalyzer.swift b/RunningLog/RunningLog/Analysis/WorkoutHistoryAnalyzer.swift
index 73a0828..786a18a 100644
--- a/RunningLog/RunningLog/Analysis/WorkoutHistoryAnalyzer.swift
+++ b/RunningLog/RunningLog/Analysis/WorkoutHistoryAnalyzer.swift
@@ -85,15 +85,30 @@ struct WorkoutHistoryAnalyzer {
         let average = totals.isEmpty ? 0 : totals.reduce(0, +) / Double(totals.count)
         let peak = totals.max() ?? 0
 
-        // Recent 4 week average
+        // Recent 4 week average.
+        //
+        // A week with no running has no key in weeklyTotals — it is a missing
+        // entry, not a zero. Dividing by recentWeeks.count therefore averaged
+        // only the weeks that happened to have runs: 40 miles in one week
+        // followed by three blank weeks reported 40 mpw instead of 10. That
+        // number floors calculateRecommendedMileage, so an athlete coming back
+        // from a layoff was started at four times their actual base. Divide by
+        // the full window instead.
         let fourWeeksAgo = calendar.date(byAdding: .weekOfYear, value: -4, to: Date()) ?? Date()
         let recentWeeks = weeklyTotals.filter { $0.key >= fourWeeksAgo }
-        let recentAverage = recentWeeks.isEmpty ? average : recentWeeks.values.reduce(0, +) / Double(recentWeeks.count)
-
-        // Trend (compare last 2 weeks to previous 2 weeks)
-        let twoWeeksAgo = calendar.date(byAdding: .weekOfYear, value: -2, to: Date()) ?? Date()
-        let lastTwoWeeks = weeklyTotals.filter { $0.key >= twoWeeksAgo }.values.reduce(0, +)
-        let previousTwoWeeks = weeklyTotals.filter { $0.key >= fourWeeksAgo && $0.key < twoWeeksAgo }.values.reduce(0, +)
+        let recentAverage = recentWeeks.isEmpty ? average : recentWeeks.values.reduce(0, +) / 4.0
+
+        // Trend (compare last 2 weeks to previous 2 weeks).
+        //
+        // The current week is excluded from both sides. It is partial by
+        // definition, so including it made every athlete read as "declining"
+        // early in the week and triggered a spurious "declining mileage trend"
+        // risk factor for someone training exactly as consistently as before.
+        let currentWeekStart = calendar.dateInterval(of: .weekOfYear, for: Date())?.start ?? Date()
+        let twoWeeksAgo = calendar.date(byAdding: .weekOfYear, value: -2, to: currentWeekStart) ?? Date()
+        let fourWeeksBeforeCurrent = calendar.date(byAdding: .weekOfYear, value: -4, to: currentWeekStart) ?? Date()
+        let lastTwoWeeks = weeklyTotals.filter { $0.key >= twoWeeksAgo && $0.key < currentWeekStart }.values.reduce(0, +)
+        let previousTwoWeeks = weeklyTotals.filter { $0.key >= fourWeeksBeforeCurrent && $0.key < twoWeeksAgo }.values.reduce(0, +)
 
         let trend: TrendDirection
         if lastTwoWeeks > previousTwoWeeks * 1.1 {
@@ -143,10 +158,17 @@ struct WorkoutHistoryAnalyzer {
         // Rough fitness index estimate based on pace (convert minutes to seconds)
         let fi = estimateFitnessIndex(paceSecondsPerMile: avgWorkoutPace * 60)
 
+        // RunningWorkout.pacePerMile is MINUTES per mile; every field on
+        // PaceProgression is documented — and consumed — as SECONDS per mile.
+        // The values above were being stored unconverted, so an 8:00/mi runner
+        // reported averageEasyPace = 8.0 while the no-data fallback above
+        // returns 540 for the same field. Both were handed to the AI assessment
+        // under the same key, so the model reasoned about "8 seconds per mile".
+        // The `* 60` on the line above is the same conversion, already correct.
         return WorkoutHistoryAnalysis.PaceProgression(
-            averageEasyPace: avgEasyPace,
-            averageWorkoutPace: avgWorkoutPace,
-            estimatedMarathonPace: estimatedMP,
+            averageEasyPace: avgEasyPace * 60,
+            averageWorkoutPace: avgWorkoutPace * 60,
+            estimatedMarathonPace: estimatedMP * 60,
             fitnessIndex: fi
         )
     }
