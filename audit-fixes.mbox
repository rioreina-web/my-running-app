         }
         .onReceive(NotificationCenter.default.publisher(for: AVAudioSession.interruptionNotification)) { note in
             // A phone call, a timer, Siri. iOS suspends the recorder; if we
@@ -939,6 +942,18 @@ struct VoiceLogView: View {
         }
     }
 
+    /// Stop the recorder and release audio resources WITHOUT presenting the
+    /// confirmation sheet. For view teardown, where there is no one to confirm.
+    /// The file stays on disk rather than being deleted.
