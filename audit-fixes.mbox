+    /// or App Store build queried Junction's sandbox and never returned a real
+    /// athlete workout. The `VITAL_BASE_URL` Info.plist key takes precedence
+    /// when present, so the host can be moved without a code change.
+    private let baseURL: String = {
+        if let override = Bundle.main.infoDictionary?["VITAL_BASE_URL"] as? String,
+           !override.isEmpty {
+            return override
+        }
+        #if DEBUG
+            return "https://api.sandbox.us.junction.com/v2"
+        #else
+            return "https://api.us.junction.com/v2"
+        #endif
+    }()
