From bdca8c1d0556ba768939ced66619c1a97f459c2f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:48:06 +0000
Subject: [PATCH 03/21] Fix 1.3: recover voice memos stranded mid-upload
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A queued item is committed as status "uploading" before its network call.
If the process dies in that window — iOS suspending or killing the app,
memory pressure, a crash — the row stays "uploading" on disk forever. The
drain fetch excludes it, pendingCount excludes it, and its audio file sits
orphaned. The memo is gone and the athlete is never told.

performDrain now sweeps stranded rows back to "pending" before fetching.
It is @MainActor and isDraining-guarded, so nothing in-process can be
legitimately mid-upload at that point — any "uploading" row is a leftover
from a previous launch. retryCount is left alone: an interrupted attempt
is not a failed one and shouldn't spend the item's retry budget.
---
 .../RunningLog/Services/OfflineQueue.swift    | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/RunningLog/RunningLog/Services/OfflineQueue.swift b/RunningLog/RunningLog/Services/OfflineQueue.swift
index 7bd4e61..6ffc933 100644
--- a/RunningLog/RunningLog/Services/OfflineQueue.swift
+++ b/RunningLog/RunningLog/Services/OfflineQueue.swift
@@ -152,6 +152,17 @@ final class OfflineQueueManager {
         // "failed" — so a dead memo from a past install stops nagging.
         purgeUnrecoverable(context: context)
 
+        // Recover rows stranded mid-flight. An item is committed as "uploading"
+        // before its network call, so if the process dies in that window (iOS
+        // suspends or kills us, memory pressure, a crash) the row stays
+        // "uploading" on disk forever: excluded from the fetch below, excluded
+        // from pendingCount, its audio file orphaned. The memo is silently lost
+        // and the athlete is never told. Nothing else in this process can be
+        // legitimately mid-upload here — performDrain is @MainActor and guarded
+        // by isDraining — so any "uploading" row we see at the top of a drain is
+        // by definition a leftover from a previous launch.
+        requeueStrandedUploads(context: context)
+
         // Exclude "failed" (retryCount maxed out) as well as in-flight items.
         // Without this, a permanently-failed row keeps matching the fetch, gets
         // re-processed on every drain, re-hits the retry cap, and re-fires its
@@ -258,6 +269,30 @@ final class OfflineQueueManager {
         }
     }
 
+    /// Return any row left in "uploading" by a previous launch to "pending".
+    ///
+    /// `performDrain` marks a row "uploading" and saves it *before* awaiting the
+    /// network, so a process death in that window strands the row permanently:
+    /// the drain fetch excludes "uploading", and so does the pending count. The
+    /// recording is preserved on disk but nothing will ever pick it up again.
+    ///
+    /// retryCount is deliberately left alone — an interrupted attempt is not a
+    /// failed one, and shouldn't spend the item's retry budget.
+    private func requeueStrandedUploads(context: ModelContext) {
+        let descriptor = FetchDescriptor<PendingUpload>(
+            predicate: #Predicate { $0.status == "uploading" }
+        )
+        guard let stranded = try? context.fetch(descriptor), !stranded.isEmpty else { return }
+
+        for item in stranded {
+            logger.warning("Re-queueing upload stranded mid-flight by a previous launch: \(item.id) (\(item.type))")
+            item.status = "pending"
+        }
+        do { try context.save() } catch { Log.app.error("SwiftData save failed (requeue stranded): \(error)") }
+        refreshCountSync(context: context)
+        logger.info("Re-queued \(stranded.count) stranded upload(s)")
+    }
+
     private func processUpload(_ upload: PendingUpload) async -> Bool {
         switch upload.type {
         case "voiceLog":
