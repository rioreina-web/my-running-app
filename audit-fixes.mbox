From c731cfe1684a0234d30df630d89afd55248abe80 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:47:26 +0000
Subject: [PATCH 02/21] Fix 1.2: guard parallel sensor arrays against length
 mismatch
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

calculateSplits validated distance.count == time.count but then indexed
velocitySmooth by the same range; calculatePaceSplits validated distance
and velocity but indexed heartrate by segment bounds. Providers regularly
return a short series — a dropped tail on a Strava/Garmin import, a watch
losing HR mid-run — and both paths crashed with index out of range on
those workouts. WorkoutSyncService calls into this too, so it could take
down a background sync.

Both series are now length-checked against times and treated as absent
when they don't match, which the surrounding code already handles (the
velocity lookup falls back to "assume moving", avgHR goes nil).
---
 .../RunningLog/Health/VitalManager.swift      | 20 +++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/RunningLog/RunningLog/Health/VitalManager.swift b/RunningLog/RunningLog/Health/VitalManager.swift
index 59acf09..37f2e29 100644
--- a/RunningLog/RunningLog/Health/VitalManager.swift
+++ b/RunningLog/RunningLog/Health/VitalManager.swift
@@ -154,7 +154,15 @@ final class VitalManager {
               distances.count == times.count, distances.count >= 2
         else { return [] }
 
-        let velocities = stream.velocitySmooth
+        // Only trust the velocity series when it lines up with the time series.
+        // Providers (Strava/Garmin via external_streams) routinely return a
+        // velocity_smooth array shorter than `time` — a dropped tail, a sensor
+        // gap. Indexing it by `times.count` crashed on exactly those runs, so
+        // treat a mismatched series as absent and fall back to "assume moving".
+        let velocities: [Double]? = {
+            guard let v = stream.velocitySmooth, v.count == times.count else { return nil }
+            return v
+        }()
         let mileInMeters = 1609.34
         // Match Garmin auto-pause: ~17:00/mile pace = 1.58 m/s
         let stoppedThreshold = 1.6 // m/s — below this, runner is stopped/walking
@@ -233,7 +241,15 @@ final class VitalManager {
               distances.count >= 30
         else { return [] }
 
-        let heartrates = stream.heartrate
+        // Same rule as the velocity series above: a heartrate array that doesn't
+        // match `times` is not safe to index by segment bounds (seg.endIndex can
+        // reach times.count - 1). A watch that drops HR mid-run — cold weather,
+        // wet strap, a tunnel — produces exactly that, and it used to crash here.
+        // Treat a mismatched series as absent; the per-segment avgHR just goes nil.
+        let heartrates: [Int]? = {
+            guard let hr = stream.heartrate, hr.count == times.count else { return nil }
+            return hr
+        }()
         let startTime = times[0]
         let mileInMeters = 1609.34
 
