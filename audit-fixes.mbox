From 293c054bb9b8d3ec6ecfa8e472be1a9e5125d909 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:46:52 +0000
Subject: [PATCH 01/21] Fix 1.1: remove KVO observer that crashed the app on
 video dismiss
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

playerItem.addObserver registered PlayerObserver.shared on
playbackLikelyToKeepUp and nothing ever removed it. onDisappear released
the AVPlayerItem while the observer was still attached, which raises
NSInternalInconsistencyException and terminates the process — a
reproducible crash on every close of the Content Library player.

PlayerObserver.observeValue was an empty stub, so the registration did no
work at all. Removed it and the now-unused PlayerObserver class.

Also captured the two NotificationCenter observer tokens and added
teardownPlayer(), called from both onDisappear and the top of
setupPlayer(). Previously each Try Again tap leaked another retained
closure and orphaned the previous item.
---
 .../RunningLog/Shared/VideoPlayerView.swift   | 92 +++++++++++--------
 1 file changed, 52 insertions(+), 40 deletions(-)

diff --git a/RunningLog/RunningLog/Shared/VideoPlayerView.swift b/RunningLog/RunningLog/Shared/VideoPlayerView.swift
index 29e76bf..275705b 100644
--- a/RunningLog/RunningLog/Shared/VideoPlayerView.swift
+++ b/RunningLog/RunningLog/Shared/VideoPlayerView.swift
@@ -19,6 +19,11 @@ struct VideoPlayerView: View {
     @State private var isBuffering = true
     @State private var error: String?
 
+    /// Tokens for the NotificationCenter observers registered in `setupPlayer`.
+    /// These MUST be removed before the player item is released — otherwise
+    /// every "Try Again" tap leaks another retained closure.
+    @State private var observerTokens: [NSObjectProtocol] = []
+
     var body: some View {
         ZStack {
             Color.black.ignoresSafeArea()
@@ -91,14 +96,35 @@ struct VideoPlayerView: View {
             setupPlayer()
         }
         .onDisappear {
-            player?.pause()
-            player = nil
+            teardownPlayer()
         }
     }
 
+    // MARK: - Teardown
+
+    /// Release the player and every observer attached to its item.
+    ///
+    /// Observers must come off BEFORE the `AVPlayerItem` deallocates. A KVO
+    /// observer that outlives its observed object raises
+    /// `NSInternalInconsistencyException` and terminates the process — which is
+    /// what used to happen on every close of this screen.
+    private func teardownPlayer() {
+        for token in observerTokens {
+            NotificationCenter.default.removeObserver(token)
+        }
+        observerTokens = []
+
+        player?.pause()
+        player = nil
+    }
+
     // MARK: - Setup Player
 
     private func setupPlayer() {
+        // "Try Again" calls straight back into here, so tear the previous
+        // attempt down first rather than orphaning its item and observers.
+        teardownPlayer()
+
         // Check if video is downloaded locally
         let downloadManager = VideoDownloadManager.shared
         let videoURL: URL
@@ -136,31 +162,34 @@ struct VideoPlayerView: View {
         newPlayer.automaticallyWaitsToMinimizeStalling = false
 
         // Observe playback status
-        NotificationCenter.default.addObserver(
-            forName: .AVPlayerItemDidPlayToEndTime,
-            object: playerItem,
-            queue: .main
-        ) { _ in
-            // Video finished - could loop or dismiss
-        }
+        observerTokens.append(
+            NotificationCenter.default.addObserver(
+                forName: .AVPlayerItemDidPlayToEndTime,
+                object: playerItem,
+                queue: .main
+            ) { _ in
+                // Video finished - could loop or dismiss
+            }
+        )
 
         // Observe for errors
-        NotificationCenter.default.addObserver(
-            forName: .AVPlayerItemFailedToPlayToEndTime,
-            object: playerItem,
-            queue: .main
-        ) { _ in
-            error = "Playback failed. Please try again."
-        }
-
-        // KVO for buffering state
-        playerItem.addObserver(
-            PlayerObserver.shared,
-            forKeyPath: "playbackLikelyToKeepUp",
-            options: [.new],
-            context: nil
+        observerTokens.append(
+            NotificationCenter.default.addObserver(
+                forName: .AVPlayerItemFailedToPlayToEndTime,
+                object: playerItem,
+                queue: .main
+            ) { _ in
+                error = "Playback failed. Please try again."
+            }
         )
 
+        // NOTE: a KVO registration on `playbackLikelyToKeepUp` used to live here,
+        // pointed at a `PlayerObserver` whose `observeValue` was an empty stub.
+        // It was never removed, so releasing the item on dismiss crashed the app.
+        // Since it did no work, it is simply gone. If buffering state is wanted
+        // later, use the block-based `playerItem.observe(\.isPlaybackLikelyToKeepUp)`
+        // and hold the returned `NSKeyValueObservation` for the view's lifetime.
+
         player = newPlayer
 
         // Start playing immediately
@@ -238,23 +267,6 @@ struct VideoPlayerView: View {
     }
 }
 
