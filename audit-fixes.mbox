From 207380e7ec6647200b6464723b1eb085e0c81ecb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 03:50:14 +0000
Subject: [PATCH 05/21] Fix 1.5: scope the athlete profile cache per account
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The UserDefaults cache key was global and nothing cleared it on sign-out,
so init()'s loadFromLocalCache() would surface the previous athlete's
lifetime mileage, paces and recurring injury history to whoever signed in
next on a shared device — and feed it into their AI coaching prompts via
profileContextForAI. Health data crossing accounts is a privacy defect,
not a stale-cache annoyance.

Keys are now suffixed with the user id, reads and writes both require a
session, and AthleteProfileService.purgeAllForSignOut() is called from the
.signedOut branch alongside the existing OfflineQueueManager purge that
was written for exactly this class of leak. init() also drops any global
blob left by an earlier build, since it can't be attributed to an account.
---
 RunningLog/RunningLog/Auth/AuthManager.swift  |  4 ++
 .../Services/AthleteProfileService.swift      | 51 ++++++++++++++++---
 2 files changed, 49 insertions(+), 6 deletions(-)

diff --git a/RunningLog/RunningLog/Auth/AuthManager.swift b/RunningLog/RunningLog/Auth/AuthManager.swift
index 2b1435c..e657b5c 100644
--- a/RunningLog/RunningLog/Auth/AuthManager.swift
+++ b/RunningLog/RunningLog/Auth/AuthManager.swift
@@ -108,6 +108,10 @@ final class AuthManager {
                     // this device would drain the departing user's memos into
                     // their own account (cross-account voice-memo leak).
                     OfflineQueueManager.shared.purgeAllForSignOut()
+                    // Same reasoning for the cached athlete profile: mileage,
+                    // paces and recurring injury history must not survive into
+                    // the next account signed in on this device.
+                    AthleteProfileService.purgeAllForSignOut()
                     self.isAuthenticated = false
                     self.currentUserId = nil
                     self.userEmail = nil
diff --git a/RunningLog/RunningLog/Services/AthleteProfileService.swift b/RunningLog/RunningLog/Services/AthleteProfileService.swift
index 1efd5de..abed1f9 100644
--- a/RunningLog/RunningLog/Services/AthleteProfileService.swift
+++ b/RunningLog/RunningLog/Services/AthleteProfileService.swift
@@ -196,9 +196,37 @@ final class AthleteProfileService {
     var isLoading = false
     var error: String?
 
-    /// Cached profile data, persisted in UserDefaults
-    private static let cacheKey = "athlete_profile_cache"
-    private static let cacheTimestampKey = "athlete_profile_cache_timestamp"
+    /// Cached profile data, persisted in UserDefaults.
+    ///
+    /// Keys are scoped per account. They used to be global, which meant that on
+    /// a shared device — a demo, a coach showing an athlete, a family iPad —
+    /// signing out and signing in as someone else surfaced the previous
+    /// athlete's mileage, paces and recurring injury history, and fed it into
+    /// their AI prompts via `profileContextForAI`. Health data crossing accounts
+    /// is a privacy defect, not just a stale-cache one.
+    private static let legacyCacheKey = "athlete_profile_cache"
+    private static let legacyCacheTimestampKey = "athlete_profile_cache_timestamp"
+
+    private static func cacheKey(for userId: String) -> String {
+        "athlete_profile_cache_\(userId)"
+    }
+
+    private static func cacheTimestampKey(for userId: String) -> String {
+        "athlete_profile_cache_timestamp_\(userId)"
+    }
+
+    /// Remove every locally cached profile, scoped and legacy alike.
+    /// Called from the sign-out path so nothing survives into the next session.
+    static func purgeAllForSignOut() {
+        let defaults = UserDefaults.standard
+        defaults.removeObject(forKey: legacyCacheKey)
+        defaults.removeObject(forKey: legacyCacheTimestampKey)
+        for key in defaults.dictionaryRepresentation().keys
+        where key.hasPrefix("athlete_profile_cache") {
+            defaults.removeObject(forKey: key)
+        }
+        Log.app.info("Purged cached athlete profile(s) on sign-out")
+    }
 
     /// - Parameter loadCache: pass `false` to start empty. The cache lives in
     ///   `UserDefaults`, which is ambient and shared with whatever the app
@@ -206,6 +234,13 @@ final class AthleteProfileService {
     ///   profile" otherwise passes on a clean simulator and fails on one the
     ///   app has actually run on.
     init(loadCache: Bool = true) {
+        // One-time cleanup: a build before per-account scoping may have left a
+        // global blob on disk. It cannot be attributed to an account, so drop it
+        // rather than risk showing it to the wrong person. Runs regardless of
+        // `loadCache` — the point is to get the unattributable blob off disk.
+        UserDefaults.standard.removeObject(forKey: Self.legacyCacheKey)
+        UserDefaults.standard.removeObject(forKey: Self.legacyCacheTimestampKey)
+
         if loadCache { loadFromLocalCache() }
     }
 
@@ -265,7 +300,10 @@ final class AthleteProfileService {
     // MARK: - Local Cache
 
     private func loadFromLocalCache() {
-        guard let data = UserDefaults.standard.data(forKey: Self.cacheKey) else { return }
+        // No session yet means no way to know whose cache this would be.
+        // Show nothing rather than guess.
+        guard let userId = AuthManager.shared.currentUserId, !userId.isEmpty else { return }
+        guard let data = UserDefaults.standard.data(forKey: Self.cacheKey(for: userId)) else { return }
         do {
             let response = try JSONDecoder().decode(AthleteProfileResponse.self, from: data)
             profile = response.profile
@@ -275,8 +313,9 @@ final class AthleteProfileService {
     }
 
     private func saveToLocalCache(data: Data) {
-        UserDefaults.standard.set(data, forKey: Self.cacheKey)
-        UserDefaults.standard.set(Date().timeIntervalSince1970, forKey: Self.cacheTimestampKey)
+        guard let userId = AuthManager.shared.currentUserId, !userId.isEmpty else { return }
+        UserDefaults.standard.set(data, forKey: Self.cacheKey(for: userId))
+        UserDefaults.standard.set(Date().timeIntervalSince1970, forKey: Self.cacheTimestampKey(for: userId))
     }
 
     private func formatPace(_ seconds: Int) -> String {
