     }
 
+    /// Shown when the fetch itself failed. ContentLibraryService swallows the
+    /// throw and returns [], so without this an offline athlete saw the same
+    /// "No Videos Yet - check back soon" as a truly empty category, with no
+    /// retry affordance and no indication anything had gone wrong.
+    private var errorStateView: some View {
+        EmptyStateView(
+            variant: .error,
+            eyebrow: category.displayName.uppercased(),
+            title: "Couldn't load these videos. Check your connection and try again.",
+            icon: category.icon,
+            cta: EmptyStateView.CTA(label: "Try Again") {
+                Task { await loadVideos() }
+            }
+        )
+    }
+
     private func loadVideos() async {
         isLoading = true
-        videos = await ContentLibraryService.shared.fetchVideos(for: category)
+        loadFailed = false
+        let fetched = await ContentLibraryService.shared.fetchVideos(for: category)
+        // fetchVideos returns [] for BOTH "no rows" and "request failed", so
