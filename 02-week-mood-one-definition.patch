+/**
+ * A week's mood: the modal DAY label across `[start, end)`, ties broken toward
+ * the most recent day.
+ *
+ * The unit is deliberately the day, not the log. A day's several logs are
+ * readings of one training unit and `hardestSessionMood` has already collapsed
+ * them; a week is a distribution over separate days, and asks the different
+ * question "what was the common register?" Counting logs here would let one
+ * heavily-logged session outvote four quiet ones.
+ *
+ * Returns null when no day in the week logged a feeling. A mood is never
+ * fabricated and never carried in from the week before.
+ */
+function modalDayMood(
+  dayMoods: Map<string, string>,
+  start: Date,
+  end: Date,
+): string | null {
+  const s = start.getTime();
+  const e = end.getTime();
+
+  // Oldest → newest, so "last seen" is "most recent".
+  const inWeek = [...dayMoods.entries()]
+    .filter(([date]) => {
+      const t = dayUTC(date).getTime();
+      return t >= s && t < e;
+    })
+    .sort((a, b) => a[0].localeCompare(b[0]));
+
+  if (inWeek.length === 0) return null; // never fabricate a feeling
+
+  const counts = new Map<string, number>();
+  const lastSeen = new Map<string, number>();
+  inWeek.forEach(([, mood], i) => {
+    counts.set(mood, (counts.get(mood) ?? 0) + 1);
+    lastSeen.set(mood, i);
+  });
+
   let best: string | null = null;
   let bestN = -1;
+  let bestSeen = -1;
   for (const [mood, n] of counts) {
