+function moodByDay(
+  input: TimelineInput,
+  featuresById: Map<string, TimelineFeature>,
+): Map<string, string> {
+  const byDay = new Map<string, TimelineLog[]>();
+  for (const l of input.logs) {
+    if (!l.mood || l.stats_excluded === true) continue;
+    const key = isoDate(dayUTC(l.workout_date));
+    (byDay.get(key) ?? byDay.set(key, []).get(key)!).push(l);
+  }
+
+  const out = new Map<string, string>();
+  for (const [key, logs] of byDay) {
+    const mood = hardestSessionMood(logs, featuresById);
+    if (mood) out.set(key, mood);
   }
+  return out;
+}
