+// ─── Week mood = modal over DAYS ───────────────────────────────────────
+//
+// The week used to count raw logs inside its own window (`dominantMood`),
+// which diverged from the days drawn underneath it in two ways. These pin
+// both, because both were visible on the Trends chart.
+
+Deno.test("week mood counts days, not logs — one heavily-logged session cannot carry the week", () => {
+  const input: TimelineInput = {
+    logs: [
+      // Mon: one tired run.
+      { id: "mon", workout_date: "2026-06-08T07:00:00Z", workout_distance_miles: 6, workout_duration_minutes: 48, workout_type: "easy", workout_pace_per_mile: "8:00", mood: "tired" },
+      // Tue: warm-up / workout / cool-down. The day reads TIRED (hardest wins),
+      // but it is three log rows.
+      { id: "wu", workout_date: "2026-06-09T06:00:00Z", workout_distance_miles: 2, workout_duration_minutes: 18, workout_type: "easy", workout_pace_per_mile: "9:00", mood: "positive" },
+      { id: "wo", workout_date: "2026-06-09T06:30:00Z", workout_distance_miles: 6, workout_duration_minutes: 40, workout_type: "tempo", workout_pace_per_mile: "6:40", mood: "tired" },
+      { id: "cd", workout_date: "2026-06-09T07:20:00Z", workout_distance_miles: 2, workout_duration_minutes: 18, workout_type: "easy", workout_pace_per_mile: "9:00", mood: "positive" },
+      // Wed: one positive run.
+      { id: "wed", workout_date: "2026-06-10T07:00:00Z", workout_distance_miles: 6, workout_duration_minutes: 48, workout_type: "easy", workout_pace_per_mile: "8:00", mood: "positive" },
+    ],
+    features: [{ training_log_id: "wo", intensity_score: 2.6, total_duration_seconds: 2400 }],
+    mentions: [],
+  };
+
+  const days = buildDailyTimeline(input, 2, REF);
+  assertEquals(days.find((d) => d.date === "2026-06-09")!.mood, "tired");
+
+  const week = buildTrendsTimeline(input, 2, REF).find((w) => w.week_start === "2026-06-08")!;
+  // Days: tired, tired, positive → tired.
+  // Counting LOGS gave positive 3–2, letting Tuesday's warm-up and cool-down
+  // outvote the two days that actually went badly.
+  assertEquals(week.mood, "tired");
+});
+
